# Copy this file to .env and fill in real values. Never commit .env.

# Local Postgres example:
# DATABASE_URL="postgresql://your_user@localhost:5432/thrivemind_dev"
DATABASE_URL=""

# A long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Comma-separated list of origins allowed to send credentialed requests
# (e.g. the deployed frontend, plus http://localhost:5173 for local dev)
CLIENT_ORIGIN="http://localhost:5173"

PORT=4000
